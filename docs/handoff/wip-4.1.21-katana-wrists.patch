+    static double sq(double d) {
+        return d > 0.0 ? d * d : 0.0;
+    }
+
+    /** How deep (pixels) a ball of {@code radius} pixels at the model point {@code m} sinks into his posed torso or head (negative: clear). */
+    static double depth(BodyFrame.Solid solid, RigPose p, double[] m, double radius) {
+        if (solid == null) {
+            // An unposed body (the solver's): its torso and head as they stand.
+            return radius - Math.min(gap(m, TORSO), gap(m, HEAD));
+        }
+        double[] rig = BodyFrame.world(p, m);
+        double r = radius * BodyFrame.SCALE / 16.0;
+        return Math.max(solid.part(rig, r, 0), solid.part(rig, r, 1));
+    }
+
+    /** His torso and head standing (model pixels: min, max), for an unposed body. */
+    static final double[][] TORSO = {{-4.0, 0.0, -2.0}, {4.0, 12.0, 2.0}};
+    static final double[][] HEAD = {{-4.0, -8.0, -4.0}, {4.0, 0.0, 4.0}};
+
+    /** The distance from {@code c} to the box (negative inside: how far in). */
+    static double gap(double[] c, double[][] box) {
+        double dx = Math.max(box[0][0] - c[0], c[0] - box[1][0]);
+        double dy = Math.max(box[0][1] - c[1], c[1] - box[1][1]);
+        double dz = Math.max(box[0][2] - c[2], c[2] - box[1][2]);
+        if (dx <= 0.0 && dy <= 0.0 && dz <= 0.0) {
+            return Math.max(dx, Math.max(dy, dz));
+        }
+        double ox = Math.max(dx, 0.0);
+        double oy = Math.max(dy, 0.0);
+        double oz = Math.max(dz, 0.0);
+        return Math.sqrt(ox * ox + oy * oy + oz * oz);
+    }
+
+    /** Whether {@code p} is posed at all (turned, leaned, stepped, its head turned): if not, its torso and head stand as they do. */
+    static boolean plain(RigPose p) {
+        return p.twist == 0.0F && p.lean == 0.0F && p.side == 0.0F && p.spin == 0.0F && p.flip == 0.0F && p.roll == 0.0F && p.drop == 0.0F
+            && p.lunge == 0.0F && p.headX == 0.0F && p.headY == 0.0F && p.headZ == 0.0F && p.bulk == 0.0F;
+    }
+
+    static BodyFrame.Solid solid(RigPose p) {
+        return plain(p) ? null : new BodyFrame.Solid(p);
+    }
+
+    /** Half way down an arm, its shoulder to its fist. */
+    static double[] middle(RigPose p, boolean right) {
+        double[] o = QuinqueGrip.pivot(p, right);
+        double[] f = QuinqueGrip.fist(p, right, false);
+        return new double[] {(o[0] + f[0]) * 0.5, (o[1] + f[1]) * 0.5, (o[2] + f[2]) * 0.5};
+    }
+
+}
