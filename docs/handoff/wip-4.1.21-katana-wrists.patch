+package com.hex.kagune.control.client.animation;
+
+import com.hex.kagune.control.quinque.Quinque;
+
+/**
+ * 4.1.21 (pure, tested; the owner, of 4.1.18's katana: "Why the fuck is the sword behind the fucking back? That, like, both arms are
+ * reaching behind the player's back. What is that?"): how far a quinque and the arms holding it sink into the body, so a swing solved by
+ * intent ({@link QuinqueAim}) never puts them through him. Measured in the body's own frame before its twist and lean (model pixels: x to
+ * his left, y down, z back from the neck): the arms ride the chest, so the twist and the lean carry them and their torso and head together,
+ * and what is clear here is clear posed. The legs (below the hips the lean turns about) are left to the swing's tests.
+ */
+public final class QuinqueReach {
+    private QuinqueReach() {
+    }
+
+    /** A fist's reach round its middle (pixels): half an arm's width. */
+    static final double FIST = 1.9;
+    /** An arm's middle may lie against his chest (a two-handed hold lays the left forearm across it), its line never in him: a hand behind his back puts it deep inside. */
+    static final double ARM = 0.1;
+
+    /**
+     * Points of a weapon written by intent, standing (its item model's pixels: x across, y along it, z through; turned onto the handheld
+     * diagonal as it is drawn) and how far round each it reaches (pixels): the katana's hilt along its axis, its guard and collar, its blade
+     * by its back and its edge (two pixels apart, curving back toward the point). Null for the rest.
+     */
+    static double[][] points(Quinque q) {
+        return q == Quinque.KATANA ? KATANA : null;
+    }
+
+    static final double[][] KATANA = katana();
+
+    static double[][] katana() {
+        java.util.List<double[]> out = new java.util.ArrayList<>();
+        for (double y : new double[] {-2.2, 0.0, 2.0, 4.0, 5.4}) {
+            out.add(new double[] {8.0, y, 8.0, 0.8});
+        }
+        out.add(new double[] {8.0, 6.35, 8.0, 1.6});
+        out.add(new double[] {8.0, 7.2, 8.0, 1.3});
+        for (double y = 8.5; y <= 31.6; y += 2.3) {
+            double f = (y - 7.6) / 24.3;
+            double back = 7.0 - 1.15 * f * f;
+            double width = Math.max(0.3, (2.1 - 0.42 * f) * (f > 0.86 ? Math.sqrt(Math.max(0.0, 1.0 - Math.pow((f - 0.86) / 0.14, 2.0))) : 1.0));
+            out.add(new double[] {back + 0.3, y, 8.0, 0.45});
+            out.add(new double[] {back + Math.max(0.3, width - 0.3), y, 8.0, 0.45});
+        }
+        return out.toArray(new double[0][]);
+    }
+
+    /**
+     * How far (pixels, squared and summed) the right fist, the left (once on its grip: {@code left}), both arms' middles and {@code q}'s
+     * weapon sink into his torso and head as {@code p} poses them (his own twist and lean carry his torso, his arms and what they hold alike).
+     */
+    public static double sunk(RigPose p, Quinque q, boolean left) {
+        BodyFrame.Solid solid = solid(p);
