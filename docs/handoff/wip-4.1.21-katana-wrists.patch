+    /** The deepest any of those sinks (pixels; 0 or less: clear), for the tests. */
+    public static double deepest(RigPose p, Quinque q) {
+        BodyFrame.Solid solid = solid(p);
+        double worst = -Double.MAX_VALUE;
+        worst = Math.max(worst, depth(solid, p, QuinqueGrip.fist(p, true, false), FIST));
+        worst = Math.max(worst, depth(solid, p, middle(p, true), ARM));
