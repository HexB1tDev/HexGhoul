diff --git a/tools/FirstPersonProbe.java b/tools/FirstPersonProbe.java
new file mode 100644
index 00000000..961bb658
--- /dev/null
+++ b/tools/FirstPersonProbe.java
@@ -0,0 +1,30 @@
+package com.hex.kagune.control.client.animation;
+
+// 4.1.19: tools/first_person_view.py feeds this a model's corners; it maps them through each swing (QuinqueGrip.held). Compile it with
+// the quick classes and run it as com.hex.kagune.control.client.animation.FirstPersonProbe <points> <out> <QUINQUE>.
+
+import com.hex.kagune.control.quinque.Quinque;
+
+/** Reads model points (x y z per line, the item model's pixels), prints each mapped onto the body (model pixels) per hit and moment. */
+public class FirstPersonProbe {
+    public static void main(String[] a) throws Exception {
+        java.util.List<String> lines = java.nio.file.Files.readAllLines(java.nio.file.Path.of(a[0]));
+        Quinque q = Quinque.valueOf(a[2]);
+        QuinqueHolds.Hold h = QuinqueHolds.of(q);
+        double[] ts = {0.0, 0.15, 0.3, 0.42, 0.5, 0.62, 0.75, 0.88};
+        StringBuilder out = new StringBuilder();
+        for (int step = 0; step < q.steps(); step++) {
+            for (double t : ts) {
+                RigPose p = new RigPose().add(QuinquePose.swing(q, step, t), 1.0F);
+                p.spin = 0.0F;
+                out.append("F ").append(step).append(' ').append(t).append('\n');
+                for (String line : lines) {
+                    String[] v = line.trim().split("\\s+");
+                    double[] m = QuinqueGrip.held(p, h, false, new float[] {Float.parseFloat(v[0]), Float.parseFloat(v[1]), Float.parseFloat(v[2])});
+                    out.append(String.format(java.util.Locale.ROOT, "%.4f %.4f %.4f%n", m[0], m[1], m[2]));
+                }
+            }
+        }
+        java.nio.file.Files.writeString(java.nio.file.Path.of(a[1]), out);
+    }
+}
diff --git a/tools/first_person_view.py b/tools/first_person_view.py
new file mode 100644
index 00000000..fc7ab24b
--- /dev/null
+++ b/tools/first_person_view.py
@@ -0,0 +1,68 @@
+"""4.1.19: first person checked off-game: python3 tools/first_person_view.py <scratch dir holding item_render.py as itemrender.py> <model.json> <texture.png> points <points.txt>; then run tools/FirstPersonProbe.java on them; then EYE="3.5 -0.5 12" python3 tools/first_person_view.py ... render <mapped.txt> <out.png> 0 0 (ArmItemLayer.FIRST_PERSON_EYE)."""
+"""True first person: the held model's corners as the third person swing places them (model pixels: x left, y down, z back from the
+neck), seen from the eye (3.63 px above the neck), raised by LIFT pixels so the grip shows; perspective 70 degrees, 16:9."""
+import json, math, sys
+from PIL import Image, ImageDraw
+sys.path.insert(0, sys.argv[1])
+import itemrender as ir
+scratch, model_path, tex_path, mode = sys.argv[1:5]
+m = json.load(open(model_path)); tex = Image.open(tex_path).convert('RGBA'); tw = tex.width
+faces = []
+for el in m['elements']:
+    fr, to = el['from'], el['to']
+    for name, corners in ir.FACES.items():
+        face = el['faces'].get(name)
+        if not face: continue
+        pts = [tuple((fr if c[i] == 'f' else to)[i] for i in range(3)) for c in corners]
+        if 'rotation' in el:
+            r = el['rotation']; pts = [ir.rot(p, r['axis'], r['angle'], r['origin']) for p in pts]
+        faces.append((pts, face['uv'], name))
+if mode == 'points':
+    with open(sys.argv[5], 'w') as f:
+        for pts, uv, name in faces:
+            for p in pts: f.write('%f %f %f\n' % p)
+    sys.exit()
+mapped_path, out, lift, ahead = sys.argv[5], sys.argv[6], float(sys.argv[7]), float(sys.argv[8])
+frames = []; cur = None
+for line in open(mapped_path):
+    if line.startswith('F'):
+        _, step, t = line.split(); cur = (int(step), float(t), []); frames.append(cur)
+    else: cur[2].append(list(map(float, line.split())))
+import os
+EYE = tuple(map(float, os.environ.get("EYE", "0 -3.63 0").split()))
+f = 1.0 / math.tan(math.radians(70) / 2)
+W, H = 320, 180
+light = {'north': 0.8, 'south': 0.8, 'east': 0.6, 'west': 0.6, 'up': 1.0, 'down': 0.5}
+def cam(p):  # model px -> camera blocks (x right, y up, z back)
+    s = 0.9375 / 16
+    return (-(p[0] - EYE[0]) * s, (-(p[1] - EYE[1]) + lift) * s, (p[2] - EYE[2] - ahead) * s)
+images = []
+for step, t, pts in frames:
+    img = Image.new('RGB', (W, H), (110, 140, 175)); dr = ImageDraw.Draw(img)
+    dr.rectangle([0, H * 0.62, W, H], fill=(84, 112, 60))
+    tris = []
+    for fi, (fpts, uv, name) in enumerate(faces):
+        c4 = [cam(pts[fi * 4 + k]) for k in range(4)]
+        if any(c[2] > -0.04 for c in c4): continue
+        u0, v0, u1, v1 = uv; n = 4
+        for i in range(n):
+            for j in range(n):
+                def at(a, b):
+                    top = [c4[0][q] + (c4[1][q] - c4[0][q]) * a for q in range(3)]; bot = [c4[3][q] + (c4[2][q] - c4[3][q]) * a for q in range(3)]
+                    return [top[q] + (bot[q] - top[q]) * b for q in range(3)]
+                qd = [at(i / n, j / n), at((i + 1) / n, j / n), at((i + 1) / n, (j + 1) / n), at(i / n, (j + 1) / n)]
+                uu = u0 + (u1 - u0) * (i + 0.5) / n; vv = v0 + (v1 - v0) * (j + 0.5) / n
+                px = tex.getpixel((min(tw - 1, max(0, int(uu / 16 * tw))), min(tw - 1, max(0, int(vv / 16 * tw)))))
+                if px[3] < 10: continue
+                scr = [(W / 2 + c[0] / -c[2] * f * H / 2, H / 2 - c[1] / -c[2] * f * H / 2) for c in qd]
+                tris.append((sum(c[2] for c in qd) / 4, scr, tuple(int(x * light[name]) for x in px[:3])))
+    tris.sort(key=lambda q: q[0])
+    for z, scr, col in tris: dr.polygon(scr, fill=col)
+    dr.line([(W/2-6, H/2), (W/2+6, H/2)], fill=(255,255,255)); dr.line([(W/2, H/2-6), (W/2, H/2+6)], fill=(255,255,255))
+    dr.text((4, H - 12), f"hit {step + 1} t{t}", fill=(255, 255, 255))
+    images.append((step, img))
+cols = 8; rows = (len(images) + cols - 1) // cols
+sheet = Image.new('RGB', (cols * W // 2, rows * H // 2))
+for i, (step, im) in enumerate(images):
+    sheet.paste(im.resize((W // 2, H // 2)), (i % cols * W // 2, i // cols * H // 2))
+sheet.save(out)
