     "minecraft:short_grass": ("minecraft:grass", ()),
@@ -749,6 +760,8 @@ def main():
     registry = None
     if "--blocks" in sys.argv:
         registry = Registry(sys.argv[sys.argv.index("--blocks") + 1])
+    ground, y0 = city_structure.make()
