+        }
+        if (g.gang() != GangPlayer.NONE) {
+            return new Said(ayato ? "You run with the Clowns. Aogiri doesn't share. Get lost."
+                : "Aogiri? Ew. Trees. The ringmaster doesn't do double acts. Ditch them first.", null);
+        }
