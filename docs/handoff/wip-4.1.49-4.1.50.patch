+    static Said talk(ServerPlayer player, Persona persona, String key, int seed) {
+        GangPlayer g = of(player);
+        int gang = gangOf(persona);
+        boolean ayato = gang == GangPlayer.AOGIRI;
+        if (g.member(gang)) {
